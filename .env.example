# Copy to .env for local runs. Never commit .env.
# The service account JSON on one line, in single quotes:
GOOGLE_SA_JSON='{"type":"service_account", ...}'
IAA_REGISTER_SHEET_ID=
IAA_INBOX_FOLDER_ID=
IAA_EVENTBRITE_TOKEN=
IAA_EVENTBRITE_ORG_ID=
IAA_MAILCHIMP_API_KEY=
IAA_MAILCHIMP_LIST_ID=
IAA_LLM_PROVIDER=none          # none | gemini | vertex
IAA_LLM_MODEL=gemini-2.5-flash
IAA_GEMINI_API_KEY=
IAA_VERTEX_PROJECT=
IAA_VERTEX_LOCATION=
IAA_VERTEX_SA_JSON=            # separate association model service account, JSON on one line
IAA_LLM_PERSONAL_DATA=false    # stays false until the Workspace migration
IAA_ENVIRONMENT=dev            # dev | prod. In prod, output is counts only
# For the live test only (docs/dev-register.md). The sheet title must contain "dev".
IAA_DEV_SHEET_ID=
IAA_DEV_INBOX_FOLDER_ID=
